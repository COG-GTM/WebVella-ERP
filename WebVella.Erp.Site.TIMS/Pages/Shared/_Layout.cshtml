<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TIMS</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .brand-logos-container {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 5px;
        }
        .brand-logo-imf {
            height: 40px;
            width: auto;
            max-width: 120px;
        }
        .brand-logo-peoplesoft {
            height: 40px;
            width: auto;
            max-width: 150px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #003399;">
        <div class="container-fluid">
            <div class="brand-logos-container">
                <img src="/_content/WebVella.Erp.Web/assets/imf-logo.svg" class="brand-logo-imf" alt="IMF" />
                <img src="/_content/WebVella.Erp.Web/assets/peoplesoft-logo.svg" class="brand-logo-peoplesoft" alt="PeopleSoft" />
            </div>
            <a class="navbar-brand" href="/">TIMS</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/missions">Missions</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/travel-requests">Travel Requests</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/claims">Claims</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/payments">Payments</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/budgets">Budgets</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
