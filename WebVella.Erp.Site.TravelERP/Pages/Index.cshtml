@page "/"
@model WebVella.Erp.Site.TravelERP.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var error = TempData["Error"] as string;

    var modules = new[] {
        new { Url = "/TravelErp/Missions",        Icon = "fa-globe-americas", Grad = "bg-grad-blue",   Title = "Missions",         Desc = "Plan, track, and report on official travel missions." },
        new { Url = "/TravelErp/TravelRequests",  Icon = "fa-paper-plane",    Grad = "bg-grad-red",    Title = "Travel Requests",  Desc = "Submit and authorize travel for upcoming missions." },
        new { Url = "/TravelErp/Claims",          Icon = "fa-receipt",        Grad = "bg-grad-amber",  Title = "Claims",           Desc = "Process expense claims with three-way matching." },
        new { Url = "/TravelErp/Payments",        Icon = "fa-university",     Grad = "bg-grad-teal",   Title = "Payments",         Desc = "Corporate banking and payment processing." },
        new { Url = "/TravelErp/Budgets",         Icon = "fa-coins",          Grad = "bg-grad-green",  Title = "Budgets",          Desc = "Departmental allocations and consumption." },
        new { Url = "/TravelErp/Approvals",       Icon = "fa-circle-check",   Grad = "bg-grad-violet", Title = "Approvals",        Desc = "Multi-level approval workflows and history." }
    };
}

<div class="container-fluid">
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="page-header">
        <div>
            <h1>
                <span class="page-icon bg-grad-blue"><i class="fas fa-plane-departure"></i></span>
                Travel ERP
            </h1>
            <div class="page-subtitle">Mission-based travel management with PeopleSoft Finance integration.</div>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var m in modules)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <a href="@m.Url" class="text-decoration-none">
                    <div class="terp-card h-100 module-card" style="transition: transform .15s ease, box-shadow .15s ease;">
                        <div class="d-flex align-items-start gap-3 p-4">
                            <span class="page-icon @m.Grad" style="width:48px; height:48px; flex:0 0 48px; font-size:1.15rem;">
                                <i class="fas @m.Icon"></i>
                            </span>
                            <div>
                                <div style="font-size:1.05rem; font-weight:600; color:#111827;">@m.Title</div>
                                <div style="font-size:.875rem; color:#6b7280; margin-top:.15rem;">@m.Desc</div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<style>
    .module-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(16,24,40,.10); }
</style>
